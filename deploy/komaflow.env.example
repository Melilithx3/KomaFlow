# /etc/komaflow/komaflow.env (Linux) or C:\komaflow\komaflow.env (Windows). See docs/03-server-ops.md §2.
KOMAFLOW_DATA_DIR=/var/lib/komaflow
KOMAFLOW_HOST=127.0.0.1
KOMAFLOW_PORT=8787
KOMAFLOW_BASE_URL=https://komaflow.tlinmo.site
KOMAFLOW_TRUST_PROXY=true
KOMAFLOW_SESSION_DAYS=90
KOMAFLOW_MAX_BLOB_MB=128
KOMAFLOW_MAX_PIXELS=200000000
KOMAFLOW_EXPORT_TTL_DAYS=7
KOMAFLOW_LOG_LEVEL=info
# Optional: move tmp/exports off the SD card
#KOMAFLOW_TMP_DIR=/mnt/usb/komaflow/tmp
#KOMAFLOW_EXPORT_DIR=/mnt/usb/komaflow/exports
# argon2id: pick values giving 0.3-0.5 s on the Pi (tools/spikes/s3-arm/argon2-bench.mjs)
KOMAFLOW_ARGON2_MEMORY_KIB=65536
KOMAFLOW_ARGON2_PASSES=3
