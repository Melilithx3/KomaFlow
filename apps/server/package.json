    "@fastify/static": "^10.1.11",
    "@komaflow/contract": "workspace:*",
    "@komaflow/psd": "workspace:*",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ag-psd": "^34.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
